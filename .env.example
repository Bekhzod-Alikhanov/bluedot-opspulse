# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Project Settings → Data API  (URL + anon/publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings → API Keys → service_role (SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Demo accounts (used by the one-click login + seed script) ────────────────
DEMO_OPS_EMAIL=ops@opspulse.demo
DEMO_OPS_PASSWORD=OpsPulse-Ops-2026
DEMO_MGMT_EMAIL=management@opspulse.demo
DEMO_MGMT_PASSWORD=OpsPulse-Mgmt-2026

# ── Cron protection (REQUIRED for monitors + digest routes) ──────────────────
CRON_SECRET=generate-any-long-random-string

# ── Resend email (OPTIONAL — simulates cleanly if absent) ────────────────────
RESEND_API_KEY=
DIGEST_FROM=OpsPulse <onboarding@resend.dev>
DIGEST_TO=you@example.com

# ── Slack incoming webhook (OPTIONAL — simulates if absent) ──────────────────
# Tip: paste a https://webhook.site URL to watch the POST land during testing.
SLACK_WEBHOOK_URL=
